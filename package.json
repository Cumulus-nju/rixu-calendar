{
  "name": "rixu-calendar",
  "version": "0.3.0",
  "private": true,
  "description": "日序 — 把微信 / QQ 聊天里的约定，自动收进极简日历（Electron）",
  "main": "main.js",
  "license": "MIT",
  "author": "Cumulus-nju",
  "homepage": "https://github.com/Cumulus-nju/rixu-calendar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cumulus-nju/rixu-calendar.git"
  },
  "bugs": {
    "url": "https://github.com/Cumulus-nju/rixu-calendar/issues"
  },
  "keywords": [
    "calendar",
    "electron",
    "wechat",
    "qq",
    "deepseek",
    "schedule",
    "chinese"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "screenshot": "electron . --screenshot",
    "shortcut": "powershell -ExecutionPolicy Bypass -File tools/create-shortcut.ps1",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.cumulusnju.rixu",
    "productName": "日序",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@koromix/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "Rixu-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "koffi": "^3.3.3",
    "ws": "^8.22.0"
  }
}
